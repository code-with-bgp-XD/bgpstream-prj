{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试: bgpstream_analyzer (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/bgpstream_analyzer",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
