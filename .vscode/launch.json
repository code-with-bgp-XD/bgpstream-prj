      "setupCommands": [
        {
          "description": "为 GDB 启用 C++ 类型的整齐打印",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "CMake: 构建 (Debug)"
    }
  ]
}
